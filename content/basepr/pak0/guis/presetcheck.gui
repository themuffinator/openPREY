// The system check for Prey's stock interface (docs/dev/ui/performance-presets.md
// "System check"): shown before the main menu when the performance presets have
// changed since this configuration last checked them. The session publishes
// every value below already localized (src/framework/Session_presetcheck.cpp)
// and takes the answers presetCheckApply, presetCheckKeep and presetCheckLater.
//
// The backdrop and wordmark are the death screen's (guis/restart.gui); the
// dialog is the stock claw frame with the Video page's heading bands and the
// stock buttons (docs/dev/prey-ui-visual-design.md, sections 6 and 9). Under
// ui_retained 1 the session draws guis/menu/presetcheck.rui over this screen and
// sets gui::retainedHome, which leaves the dialog undrawn.

#include "guis/mainmenu/menucolors.guifragment"

windowDef Desktop {
	rect		0, 0, 640, 480
	backcolor	0, 0, 0, 1
	menugui		1

	// Back asks again at the next start; it changes no setting.
	onESC {
		if ( "gui::check_busy" == 0 && "gui::retainedHome" == 0 ) {
			set "cmd" "play guisounds_menu_cancel ; presetCheckLater" ;
		}
	}

	windowDef PC_Backdrop {
		rect		0, 0, 640, 480
		noclip		1
		noevents	1
		backcolor	0, 0, 0, 0
		matcolor	1, 1, 1, 1
		background	"guis/assets/menu/background_center"
		backgroundLeft	"guis/assets/menu/background_left"
		backgroundRight	"guis/assets/menu/background_right"
		backgroundTop	"guis/assets/menu/background_top"
		backgroundBottom "guis/assets/menu/background_bottom"
	}

	windowDef PC_Logo {
		rect		190, 14, 260, 18
		background	"guis/assets/menu/prey"
		matcolor	1, 1, 1, 1
		noevents	1
	}

	// The dialog: a confirmation's 0.5 scrim and the claw frame grown to the readout.
	windowDef PC_Dialog {
		rect		0, 0, 640, 480
		visible		("gui::retainedHome" == 0)

