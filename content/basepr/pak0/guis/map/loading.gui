// Level loading gui, can have a unique one for each map

windowDef Desktop {
	rect		0, 0, 640, 480
	backcolor	0.20, 0.20, 0.40, 1
	forecolor	1, 1, 0, 1
	nocursor	1
	menugui		1

	// The session always sets loading_bkgnd: the map's
	// guis/assets/loading/<map> art or the generic loading picture. A default
	// set here would always win, since GUI expressions compare as numbers and
	// any image name equals "". In a window that is not 4:3 the session
	// composes the art and its _left/_right/_top/_bottom tiles into one
	// picture of the window's shape and sets loading_bkgnd_canvasfill;
	// otherwise the 4:3 art is drawn alone.
	windowDef BackgroundWide {
		rect		( 0 - "gui::virtual_screen_x_expand" ), ( 0 - "gui::virtual_screen_y_expand" ), ( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ), ( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "gui::loading_bkgnd_canvasfill" == 1 )
		backcolor	0, 0, 0, 0
		matcolor	1, 1, 1, 1
		background	"gui::loading_bkgnd"
		matcanvasfill	1
		noclip		1
	}

	windowDef BackgroundLegacy {
		rect		0, 0, 640, 480
		visible		( "gui::loading_bkgnd_canvasfill" == 0 )
		backcolor	0, 0, 0, 0
		matcolor	1, 1, 1, 1
		background	"gui::loading_bkgnd"
		noclip		1
	}

	// The name notch (prey-ui-visual-design.md, section 12.1): the progress
	// outline hung from the top edge and bent round the level's name, drawn
	// from tools/ui/loading_notch.py's pieces. Its foot runs the name's width
	// plus 16 u each side, never under 168 u, so the pieces read the width
	// NameMeasure measures (its text is the name, drawn clear). The expression
	// parser groups subtraction from the right (a - b - c is a - (b - c)), so
	// no rect chains two. The session plays the intro through the
	// loading_notch_* and loading_*_fade states (idSessionLocal::
	// PublishLoadingIntro): the notch lowers into view closed, its ends
	// meeting at the centre, and opens; the rivets set, the name shows and
	// the foot fades in.
	windowDef NameMeasure {
		rect		0, 3, 640, 30
		screenaligny top
		forecolor	0, 0, 0, 0
		text		"gui::loading_levelname"
		textscale	0.6
		textalign	1
		font		"fonts/menu"
	}

	windowDef NotchLead {
		rect		259.011 - ( 84 + ( "NameMeasure::textwidth" / 2 + 16 - 84 ) * ( "NameMeasure::textwidth" / 2 + 16 > 84 ) ) * "gui::loading_notch_open", ( "gui::loading_notch_drop" - 1 ) * 64, 60.989, 64
		screenaligny top
		background	"guis/assets/loading/namenotch_end"
		matcolor	1, 1, 1, 1
	}

	windowDef NotchMiddle {
		rect		320 - ( 84 + ( "NameMeasure::textwidth" / 2 + 16 - 84 ) * ( "NameMeasure::textwidth" / 2 + 16 > 84 ) ) * "gui::loading_notch_open", ( "gui::loading_notch_drop" - 1 ) * 64, ( 84 + ( "NameMeasure::textwidth" / 2 + 16 - 84 ) * ( "NameMeasure::textwidth" / 2 + 16 > 84 ) ) * 2 * "gui::loading_notch_open", 64
		screenaligny top
		background	"guis/assets/loading/namenotch_mid"
		matcolor	1, 1, 1, 1
	}

	windowDef NotchTrail {
		rect		320 + ( 84 + ( "NameMeasure::textwidth" / 2 + 16 - 84 ) * ( "NameMeasure::textwidth" / 2 + 16 > 84 ) ) * "gui::loading_notch_open", ( "gui::loading_notch_drop" - 1 ) * 64, 60.989, 64
		screenaligny top
		background	"guis/assets/loading/namenotch_end"
		matcolor	1, 1, 1, 1
		matscalex	-1
	}

	windowDef NotchRivets0 {
		rect		304 - ( ( 84 + ( "NameMeasure::textwidth" / 2 + 16 - 84 ) * ( "NameMeasure::textwidth" / 2 + 16 > 84 ) ) - 12 ), 29, 32, 16
		screenaligny top
		background	"guis/assets/loading/namenotch_rivets"
		matcolor	1, 1, 1, "gui::loading_notch_rivets"
	}

	windowDef NotchRivets1 {
		rect		304 - ( ( 84 + ( "NameMeasure::textwidth" / 2 + 16 - 84 ) * ( "NameMeasure::textwidth" / 2 + 16 > 84 ) ) - 12 ) * 0.5, 29, 32, 16
		screenaligny top
		background	"guis/assets/loading/namenotch_rivets"
		matcolor	1, 1, 1, "gui::loading_notch_rivets"
	}

	windowDef NotchRivets2 {
		rect		304, 29, 32, 16
		screenaligny top
		background	"guis/assets/loading/namenotch_rivets"
		matcolor	1, 1, 1, "gui::loading_notch_rivets"
	}

	windowDef NotchRivets3 {
		rect		304 + ( ( 84 + ( "NameMeasure::textwidth" / 2 + 16 - 84 ) * ( "NameMeasure::textwidth" / 2 + 16 > 84 ) ) - 12 ) * 0.5, 29, 32, 16
		screenaligny top
		background	"guis/assets/loading/namenotch_rivets"
		matcolor	1, 1, 1, "gui::loading_notch_rivets"
	}

	windowDef NotchRivets4 {
		rect		304 + ( ( 84 + ( "NameMeasure::textwidth" / 2 + 16 - 84 ) * ( "NameMeasure::textwidth" / 2 + 16 > 84 ) ) - 12 ), 29, 32, 16
		screenaligny top
		background	"guis/assets/loading/namenotch_rivets"
		matcolor	1, 1, 1, "gui::loading_notch_rivets"
	}

	windowDef FriendlyName {
		rect		0, 3, 640, 30
		screenaligny top
		forecolor	0.65, 0.75, 1, 0.8 * "gui::loading_name_fade"
		text		"gui::loading_levelname"
		textscale	0.6
		textalign	1
		textaligny	-5
		shadow		1
		font		"fonts/menu"
	}

	windowDef AuthorName {
		rect		0, 46, 640, 20
		screenaligny top
		visible		"gui::loading_author_visible"
		forecolor	0.85, 0.85, 1, 0.75 * "gui::loading_name_fade"
		text		"gui::loading_author"
		textscale	0.3
		textalign	1
		textaligny	-2
		shadow		1
		font		"fonts/menu"
	}

	windowDef ObjectivesBack {
		rect		20, 348, 430, 74
		screenaligny bottom
		visible		"gui::loading_objectives_visible"
		background	"textures/gfx/colors/white"
		matcolor	0.0, 0.0, 0.0, 0.45 * "gui::loading_foot_fade"
	}

	windowDef Objectives {
		rect		32, 356, 406, 58
		screenaligny bottom
		visible		"gui::loading_objectives_visible"
		forecolor	0.86, 0.9, 1.0, 0.82 * "gui::loading_foot_fade"
		text		"gui::loading_objectives"
		textscale	0.28
		textalign	0
		textaligny	0
		shadow		1
		font		"fonts/menu"
	}

	// Progress Bar
	windowDef ProgressBarClip {
		rect	192, 455, ("gui::map_loading" * 256), 12
		screenaligny bottom
		
		windowDef ProgressBarFill {
			rect		0, 0, 256, 12
			background	"textures/gfx/colors/white"
			matcolor	0.35, 0.35, 1, 0.65 * "gui::loading_foot_fade"
		}
	}
	windowDef baroutline {
		rect		168, 443, 304, 30
		screenaligny bottom
		background	"guis/assets/menu/bottombar"
		matcolor	1, 1, 1, "gui::loading_foot_fade"
	}

	windowDef LoadingText {
		rect		474, 445, 146, 20
		screenaligny bottom
		forecolor	0.75, 0.82, 1.0, 0.72 * "gui::loading_foot_fade"
		text		"gui::loading_message"
		textscale	0.4
		textalign	2
		textaligny	-2
		shadow		1
		font		"fonts/menu"
	}
}
