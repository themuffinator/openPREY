  "exitYes": [{"op": "action", "action": "soundClick"}, {"op": "action", "action": "quit"}],
  "exitShow": [
   {"op": "action", "action": "soundSlideInSmall"},
   {"op": "setState", "values": {"exit.visible": true, "page.open": true}},
   {"op": "playTimeline", "timeline": "exitEnter"}
  ],
  "exitHide": [{"op": "action", "action": "soundSlideOutSmall"}, {"op": "playTimeline", "timeline": "exitLeave"}],
  "exitCancel": [{"op": "action", "action": "soundCancel"}, {"op": "call", "event": "exitHide"}],
  "exitHidden": [
   {"op": "setState", "values": {"exit.visible": false, "page.open": false}},
   {"op": "focus", "control": "nav_exit"}
  ],
  "onBack": [{"op": "call", "event": "pickExit"}],
  "open": [
   {"op": "setState", "values": {"home.released": false}},
   {"op": "playTimeline", "timeline": "open"},
   {
    "op": "if",
    "condition": {"state": "menu_continue"},
    "then": [{"op": "focus", "control": "nav_resume"}],
    "else": [{"op": "focus", "control": "nav_newgame"}]
   }
  ],
  "returnHome": [{"op": "call", "event": "open"}],
  "release": [{"op": "setState", "values": {"home.released": true}}],
  "depart": [{"op": "setState", "values": {"home.released": true}}],
  "carry_loadGame": [{"op": "setState", "values": {"home.released": true}}],
  "carry_saveGame": [{"op": "setState", "values": {"home.released": true}}],
  "carry_restartLevel": [{"op": "setState", "values": {"home.released": true}}],
  "carry_credits": [{"op": "setState", "values": {"home.released": true}}],
  "carry_multiplayer": [{"op": "setState", "values": {"home.released": true}}],
  "carry_settings": [{"op": "setState", "values": {"home.released": true}}]
 },
