          "hover": "chat_tab1.hover",
          "focus": "chat_tab1.focus",
          "pressed": "chat_tab1.pressed",
          "disabled": "chat_tab1.disabled"
         },
         "event": "chat_tab1Pick"
        }
       }
      ]
     }
    ]
   }
  ]
 }
}
