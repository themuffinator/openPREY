// The main menu's Earth window (guis/mainmenu.gui) continues past the 4:3
// canvas through these edge slices. Each repeats the stages of the stock
// guis/assets/menu/preymenu/earth material over art generated by
// tools/assets/generate_menu_backdrop_tiles.py; the slices' texture
// coordinates continue the window's, so the drifting cloud stage runs on
// across the join.

guis/assets/menu/preymenu/earth_left
{
	{
		blend blend
		map guis/assets/menu/preymenu/earth_left.tga
		linear
		clamp
		nopicmip
	}
	{
		maskcolor
		map guis/assets/menu/preymenu/earth_left.tga
		linear
		clamp
		nopicmip
	}
	{
		maskalpha
		blend	gl_dst_alpha, gl_one
		map guis/assets/menu/preymenu/earthclouds.tga
		rgb 0.2
		scroll 0-time*0.07, time*0.03
		scale 4,4
		linear
		nopicmip
	}
}

