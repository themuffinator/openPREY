// Generated by tools/assets/generate_menu_scene.py; do not edit.
// The main menu's 3D backdrop (docs/dev/prey-ui-visual-design.md section
// 12.2). The Sphere is a hollow shell of lit rock, cut by its gaps (alpha
// test), over an inside wall of ice that the sun inside it lights; Earth is
// the game's own map, under its air and its glow.

// The shell: lit by the renderDef's key light (from below, Earth's side) and
// its fill (from the front), relief from its own luminance, wet sheen, and
// the green glows. A faint ambient keeps its dark side from going black.
models/menu/scene/shell
{
	noShadows
	noSelfShadow
	bumpmap heightmap( guis/assets/menu/scene/shell, 9 )
	{
		blend diffusemap
		map guis/assets/menu/scene/shell.tga
		alphatest 0.5
	}
	{
		blend specularmap
		map guis/assets/menu/scene/shell.tga
		rgb 0.45
	}
	{
		blend add
		map guis/assets/menu/scene/shell.tga
		rgb 0.035
		alphatest 0.5
	}
	{
		blend add
		map guis/assets/menu/scene/shell_glow.tga
	}
}

// The inside wall, lit evenly by the sun at the centre: unlit.
models/menu/scene/inside
{
	noShadows
	{
		map guis/assets/menu/scene/inside.tga
		rgb 0.9
	}
}

// The stock sun (guis/assets/menu/preymenu/sol) on a billboard the renderDef
// keeps at the Sphere's centre: seen only through the gaps.
models/menu/scene/sun
{
	noShadows
	translucent
	sort far
	{
		blend add
		map models/mapobjects/skybox/sun1.tga
		rotate time*0.01
		rgb solsurge[time*0.17]*1.0
		linear
		clamp
	}
}

// Prey's outro Earth map, shown unlit; it turns at 1.5 u a second along the limb.
models/menu/scene/earth
{
	noShadows
	{
		map textures/outro/earthcomp4096
		rgb 1.12
		scale 0.001, 0.001
		scroll time*0.0001451, 0
		highres
	}
}

models/menu/scene/haze
{
	noShadows
	translucent
	sort close
	{
		blend add
		map guis/assets/menu/scene/haze.tga
		scale 0.001, 0.001
		clamp
		linear
	}
}

models/menu/scene/glow
{
	noShadows
	translucent
	sort 6
	{
		blend add
		map guis/assets/menu/scene/glow.tga
		clamp
		linear
	}
}
