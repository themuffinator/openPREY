// Generated by tools/assets/generate_menu_scene.py; do not edit.
// The main menu's 3D backdrop (docs/dev/prey-ui-visual-design.md section
// 12.2). Every surface is unlit: the key light is baked into the shell's
// texture, the plates are self-lit as the painting shows them, and Earth's
// limb, cloud deck and glow are graded for the rest camera, which is where
// the camera is whenever Earth is in view.

models/menu/scene/shell
{
	noShadows
	{
		map guis/assets/menu/scene/shell.tga
		clamp
		linear
	}
}

models/menu/scene/earth
{
	noShadows
	{
		map guis/assets/menu/scene/earth.tga
		clamp
		linear
	}
}

// The stock sun flare's stage (guis/assets/menu/preymenu/sol), on a billboard
// the renderDef keeps on the shell's camera side: over the shell, under the
// plates.
models/menu/scene/sun
{
	noShadows
	translucent
	sort far
	{
		blend add
		map models/mapobjects/skybox/sun1.tga
		rotate time*0.01
		rgb solsurge[time*0.17]*1
		linear
		clamp
	}
}

// The craters darken the shell before the plates draw over it.
models/menu/scene/craters
{
	noShadows
	translucent
	sort 3.5
	{
		blend filter
		map _white
		vertexColor
	}
}

// Each plate's colour is its vertices', over the tiling ice.
models/menu/scene/surface
{
	noShadows
	translucent
	sort medium
	{
		blend blend
		map guis/assets/menu/scene/ice.tga
		vertexColor
	}
}

// Drifts 1.5 u a second along the limb.
models/menu/scene/clouds
{
	noShadows
	translucent
	sort close
	{
		blend blend
		map guis/assets/menu/scene/clouds.tga
		scroll time*0.001268, 0
	}
}

models/menu/scene/glow
{
	noShadows
	translucent
	sort 6
	{
		blend add
		map guis/assets/menu/scene/glow.tga
		clamp
		linear
	}
}
